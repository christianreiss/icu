#!/bin/sh
# `meson` for the Windows cross build of webrtc-audio-processing (feature
# `aec`, Research/aec.md A1). Its crate's build.rs runs `meson setup`
# without a cross file and would build ELF objects; put this directory
# first in PATH (packaging/windows/build.sh does). For the Windows target
# `setup` gets build/win-aec/mingw64.ini, and the copied sources lose
# WEBRTC_ENABLE_SYMBOL_EXPORT: in a static library its dllexport
# directives only name symbols the crate later renames (v2_ prefix), and
# the link fails with "cannot export …: symbol not found". Anything else
# is plain meson.
here=$(cd "$(dirname "$0")" && pwd)
PATH=$(printf '%s' "$PATH" | tr ':' '\n' | grep -vx "$here" | paste -sd: -)
export PATH
if [ "$1" = "setup" ] && [ "$TARGET" = "x86_64-pc-windows-gnu" ]; then
    shift
    for src; do :; done  # the last argument: the source directory
    if [ -f "$src/meson.build" ]; then
        sed -i "/'-DWEBRTC_ENABLE_SYMBOL_EXPORT',/d" "$src/meson.build"
    fi
    exec meson setup --cross-file "$here/mingw64.ini" "$@"
fi
exec meson "$@"
