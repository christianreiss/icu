[Unit]
Description=ICU voice server
After=network-online.target
Wants=network-online.target
# A server that cannot start (unreadable state, bad configuration) gives up
# after five tries in a minute and shows as failed, instead of looping with
# Restart= for good.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
# Started once the binary is executed, not merely forked: a missing or
# broken binary fails the start instead of showing as running.
Type=exec
ExecStart=/usr/bin/icu-server run --config /etc/icu/server.toml
DynamicUser=yes
# Private by default, including temporary files created during key rotation.
UMask=0077
# The static group `icu` (sysusers) as the service's primary group, with a
# dynamic user: /run/icu then belongs to icu-server:icu, so members of `icu`
# (admins) can reach /run/icu/admin.sock (0660, group
# `server.admin_socket_group` = icu). Without it RuntimeDirectory belonged to
# the dynamic group and nobody else got through the directory. The state
# stays private: systemd keeps it under /var/lib/private (0700 root).
Group=icu
# The monitoring socket is handed to `server.monitor_socket_group`
# (`icu-monitor`, created by sysusers and the packages' preinstall). Without
# CAP_CHOWN a process may only give a file to a group it belongs to, and
# the dynamic user is in `icu` alone: the chgrp failed with EPERM, the
# socket stayed `icu` (full admin) and a monitoring agent that is only in
# `icu-monitor` could not open it. Membership grants the service nothing
# else — no file belongs to that group but this socket.
SupplementaryGroups=icu-monitor
StateDirectory=icu
# Keys and users.toml: nobody but the service. The sockets live in
# RuntimeDirectory, so the groups keep their way in.
StateDirectoryMode=0700
RuntimeDirectory=icu
# 0755, not 0750: since 2026-09-28 a second socket `monitor.sock` may belong
# to a group of its own (`server.monitor_socket_group`, e.g. `icu-monitor`)
# so that a Checkmk agent needs no admin rights. Through a 0750 directory
# owned by `icu` that group would never get to it. The directory holds
# nothing but the two socket files; each one's own 0660 and group is the
# gate.
RuntimeDirectoryMode=0755
ConfigurationDirectory=icu
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
PrivateDevices=yes
PrivateIPC=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallFilter=@system-service
# Not ~@privileged: it contains @chown, and the server chgrps the admin socket
# to `admin_socket_group` (fchownat), so it would die with SIGSYS at startup.
SystemCallFilter=~@resources
SystemCallArchitectures=native
MemoryDenyWriteExecute=yes
LockPersonality=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictNamespaces=yes
RestrictRealtime=yes
CapabilityBoundingSet=
# Backstop for an open-internet server: the server caps connections itself
# (limits.max_connections), this caps what a bug could still make it hold.
MemoryMax=1G
# A crash must not write the CA and com keys into a core dump.
LimitCORE=0
Restart=on-failure
RestartSec=2

# For a port below 1024, drop the empty CapabilityBoundingSet and add:
#   AmbientCapabilities=CAP_NET_BIND_SERVICE
#   CapabilityBoundingSet=CAP_NET_BIND_SERVICE

[Install]
WantedBy=multi-user.target
