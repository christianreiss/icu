# Deployed as downloads/.htaccess: plain files only, never executed.
Options -ExecCGI
<FilesMatch "\.(php[0-9]?|phar|phtml|pht|cgi|pl|py|sh)$">
	Require all denied
</FilesMatch>
<FilesMatch "^\.">
	Require all denied
</FilesMatch>
<IfModule mod_headers.c>
	<FilesMatch "^latest\.json$">
		Header set Cache-Control "no-cache"
	</FilesMatch>
</IfModule>
