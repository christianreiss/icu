# Caddy vhost for icu.uggs.io, e.g. /etc/caddy/vhosts/icu.uggs.io.caddy
# (the fleet's Caddy hosts keep one file per vhost there).
#
# Point `root` at a checkout or rsync target of web/. Nothing else is needed:
# the site is plain static files and makes no third-party requests.
# web/tools/ and web/deploy/ are build helpers, not site content; they are
# denied below in case the whole of web/ is the document root.
icu.uggs.io {
	root * /srv/icu.uggs.io
	encode zstd gzip

	log icu.uggs.io {
		output file /var/log/caddy/icu.uggs.io.access.log {
			roll_size 20MiB
			roll_keep 10
		}
		format json
	}

	@internal {
		path /tools/* /deploy/* /README.md *.py
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		Strict-Transport-Security "max-age=31536000"
	}

	# Fonts and images never change under the same name; versioned packages
	# live in their own directory; the manifest must always be revalidated.
	@static path /assets/*
	header @static Cache-Control "public, max-age=31536000, immutable"
	@pkgs path /downloads/*
	header @pkgs Cache-Control "public, max-age=86400"
	@manifest path /downloads/latest.json /index.html /
	header @manifest Cache-Control "no-cache"

	# The versioned package directories are immutable once published.
	@versioned path_regexp ^/downloads/[0-9]+\.[0-9]+\.[0-9]+/
	header @versioned Cache-Control "public, max-age=31536000, immutable"

	handle @internal {
		respond 404
	}
	# /downloads/ lists the packages for the <noscript> fallback
	handle /downloads/* {
		file_server browse
	}
	handle {
		file_server
	}
	handle_errors {
		rewrite * /404.html
		file_server
	}
}
